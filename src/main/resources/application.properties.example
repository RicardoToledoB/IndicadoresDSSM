# RRFF-SSM - editar directamente antes de iniciar (sin Docker ni export)
server.port=8097
server.forward-headers-strategy=framework
server.error.include-message=never
spring.application.name=rrff-ssm
spring.datasource.url=jdbc:mysql://localhost:3306/rrff_ssm?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
spring.datasource.username=rrff_app
spring.datasource.password=CAMBIAR_PASSWORD_MYSQL
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=false
spring.jackson.time-zone=America/Punta_Arenas
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never
# Se exige cambiar por una clave aleatoria privada de al menos 32 bytes UTF-8
app.jwt.secret=CAMBIAR_SECRETO_PRIVADO_DE_MINIMO_32_BYTES
app.jwt.issuer=rrff-ssm
app.jwt.expiration-minutes=30
app.cors.allowed-origin=http://localhost:4200
# Escritura PD: deshabilitada hasta autorización y habilitación explícita
app.features.writes-enabled=false
# HABILITADO SOLO PARA PRIMER ARRANQUE EN BASE NUEVA: poner false despues de confirmar login
app.bootstrap.enabled=false
app.bootstrap.username=admin
app.bootstrap.password=CAMBIAR_ADMIN_PASSWORD
# 7.2 RRFF: carga histórica R04 en tablas r72_* ejecutada por Flyway V2,V3,V4
# Las cuentas provisionales USxxxx de R04 no son usuarios reales de seguridad M05.
# GET permitido según rol; POST/PUT se mantienen deshabilitados por app.features.writes-enabled=false

# IMPORTANTE: credenciales de prueba incorporadas por solicitud del usuario (23-11-2026).
# NO usar este archivo en un repositorio ni compartir el ZIP; cambiar MySQL/admin/JWT antes de produccion.

# Swagger OpenAPI (preferentemente solo red de desarrollo)
springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true
